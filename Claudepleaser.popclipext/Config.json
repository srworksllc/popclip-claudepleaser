    {
      "identifier": "lang-zh",
      "label": "Chinese (Simplified)",
      "type": "boolean",
      "defaultValue": false,
      "inset": true
    },
    {
      "identifier": "lang-ja",
      "label": "Japanese",
      "type": "boolean",
      "defaultValue": false,
