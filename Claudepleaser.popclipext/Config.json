  "authorURL": "https://srworks.co",
  "popclipVersion": 5992,
  "module": "settings.js",
  "entitlements": [
    "network"
  ],
  "options": [
    {
      "identifier": "apikeys-heading",
      "type": "heading",
      "label": "API Key"
    },
    {
      "identifier": "claudeapikey",
      "label": "Anthropic",
      "type": "secret",
      "description": "https://console.anthropic.com/settings/keys"
    },
    {
      "identifier": "model",
      "label": "Model",
      "type": "multiple",
      "defaultValue": "smart",
      "values": [
        "smart",
        "fast"
      ],
      "valueLabels": [
        "Sonnet (Smarter)",
        "Haiku (Faster)"
      ]
    },
    {
      "identifier": "tone",
      "label": "Tone",
      "type": "multiple",
      "defaultValue": "default",
      "values": [
        "default",
        "professional",
        "casual",
        "friendly",
        "direct"
      ],
      "valueLabels": [
        "Default",
        "Professional",
        "Casual",
        "Friendly",
        "Direct"
      ]
    },
    {
      "identifier": "actions-heading",
      "type": "heading",
      "label": "Actions"
    },
    {
      "identifier": "enable-improve-writing",
      "label": "Improve Writing",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-spelling-grammar",
      "label": "Spelling & Grammar",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-make-longer",
      "label": "Make Longer",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-make-shorter",
      "label": "Make Shorter",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-summarize",
      "label": "Summarize",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-translate",
      "label": "Translate",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "translate-heading",
      "type": "heading",
      "label": "Translate Languages"
    },
    {
      "identifier": "lang-es",
      "label": "Spanish",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
