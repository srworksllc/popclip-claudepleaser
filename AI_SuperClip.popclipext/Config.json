{
  "name": "AI SuperClip",
  "version": "1.2.0",
  "icon": "symbol:brain",
  "identifier": "com.srworks.popclip.extension.ai-superclip",
  "description": "Enhance the selected text with Claude and paste the result. Hold Shift (\u21e7) to copy instead.",
  "author": "Steve Reinhardt",
  "authorURL": "https://srworks.co",
  "popclipVersion": 4069,
  "module": "settings.js",
  "entitlements": [
    "network"
  ],
  "options": [
    {
      "identifier": "apikeys-heading",
      "type": "heading",
      "label": "API Key"
    },
    {
      "identifier": "claudeapikey",
      "label": "Anthropic",
      "type": "secret",
      "description": "console.anthropic.com/settings/keys"
    },
    {
      "identifier": "model",
      "label": "Model",
      "type": "multiple",
      "defaultValue": "smart",
      "values": [
        "smart",
        "fast"
      ],
      "valueLabels": [
        "Sonnet (Smarter)",
        "Haiku (Faster)"
      ]
    },
    {
      "identifier": "tone",
      "label": "Tone",
      "type": "multiple",
      "defaultValue": "default",
      "values": [
        "default",
        "professional",
        "casual",
        "friendly",
        "direct"
      ],
      "valueLabels": [
        "Default",
        "Professional",
        "Casual",
        "Friendly",
        "Direct"
      ]
    },
    {
      "identifier": "actions-heading",
      "type": "heading",
      "label": "Actions"
    },
    {
      "identifier": "enable-improve-writing",
      "label": "Improve Writing",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-spelling-grammar",
      "label": "Spelling & Grammar",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-make-longer",
      "label": "Make Longer",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-make-shorter",
      "label": "Make Shorter",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "enable-summarize",
      "label": "Summarize",
      "type": "boolean",
      "defaultValue": true,
      "inset": true
    },
    {
      "identifier": "version-heading",
      "type": "heading",
      "label": "Version 1.2.0 \u00b7 srworks.co"
    }
  ]
}
